{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquivabilidade.ja/schemas/0.1.0/indicators.schema.json",
  "title": "Methodology indicators",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "methodology_version", "defaults", "indicators"],
  "properties": {
    "$schema": {"type": "string"},
    "methodology_version": {"type": "string"},
    "defaults": {"type": "object"},
    "indicators": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/indicator"}
    }
  },
  "$defs": {
    "indicator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "slug", "name", "description", "origin", "dimension", "clear_plus_facets", "classification", "default_severity", "score", "blocking_candidates", "measurement_method", "evidence_requirements", "limitations"],
      "properties": {
        "id": {"type": "string", "pattern": "^[DRSCMON][0-9]{2}$"},
        "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "origin": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "refs"],
          "properties": {
            "kind": {"enum": ["clear_plus", "adaptation", "correction", "new"]},
            "refs": {"type": "array", "items": {"type": "string"}}
          }
        },
        "dimension": {
          "type": ["string", "null"],
          "enum": ["discoverability", "retrievability", "standards_formats", "dependency_cohesion", "metadata_context", "operational_harvestability", null]
        },
        "report_section": {"type": "string"},
        "clear_plus_facets": {"type": "array", "items": {"enum": ["FA", "FS", "FC", "FM"]}, "uniqueItems": true},
        "classification": {"enum": ["intrinsic", "harvest_dependent", "observation_context"]},
        "default_severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "score": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "weight", "rule"],
          "properties": {
            "enabled": {"type": "boolean"},
            "weight": {"type": "number", "minimum": 0},
            "rule": {"enum": ["status_map", "context_only"]}
          }
        },
        "blocking_candidates": {"type": "array", "items": {"pattern": "^HG[0-9]{2}$"}, "uniqueItems": true},
        "measurement_method": {"type": "string", "minLength": 1},
        "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "limitations": {"type": "string", "minLength": 1}
      }
    }
  }
}
