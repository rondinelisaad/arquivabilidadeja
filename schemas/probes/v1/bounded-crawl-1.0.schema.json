{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquivabilidade.ja/schemas/probes/v1/bounded-crawl-1.0.schema.json",
  "title": "Bounded crawl aggregate observation payload 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["limits", "robots", "summary"],
  "properties": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth", "max_urls", "max_response_bytes", "max_total_bytes", "max_total_elapsed_milliseconds", "max_links_per_document"],
      "properties": {
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 5},
        "max_urls": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "max_total_elapsed_milliseconds": {"type": "number", "minimum": 100, "maximum": 300000},
        "max_links_per_document": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "robots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "matched_rule", "matched_octets", "matched_group_count", "applicable_rule_count", "policy_id", "parser_version", "product_token", "source_state"],
      "properties": {
        "disposition": {"enum": ["allow", "disallow"]},
        "matched_rule": {"enum": ["allow", "disallow", null]},
        "matched_octets": {"type": "integer", "minimum": 0},
        "matched_group_count": {"type": "integer", "minimum": 0},
        "applicable_rule_count": {"type": "integer", "minimum": 0},
        "policy_id": {"type": "string", "maxLength": 128},
        "parser_version": {"type": "string", "maxLength": 128},
        "product_token": {"type": "string", "maxLength": 128},
        "source_state": {"enum": ["parsed", "unavailable", "unreachable"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered_references", "discovered_unique_internal", "enqueued", "visited", "successful", "broken_internal", "edge_count", "maximum_depth_reached", "response_bytes", "elapsed_milliseconds", "status_classes", "failures", "discarded", "termination_reason"],
      "properties": {
        "discovered_references": {"type": "integer", "minimum": 0},
        "discovered_unique_internal": {"type": "integer", "minimum": 1},
        "enqueued": {"type": "integer", "minimum": 1, "maximum": 100},
        "visited": {"type": "integer", "minimum": 0, "maximum": 100},
        "successful": {"type": "integer", "minimum": 0, "maximum": 100},
        "broken_internal": {"type": "integer", "minimum": 0, "maximum": 100},
        "edge_count": {"type": "integer", "minimum": 0},
        "maximum_depth_reached": {"type": "integer", "minimum": 0, "maximum": 5},
        "response_bytes": {"type": "integer", "minimum": 0, "maximum": 104857600},
        "elapsed_milliseconds": {"type": "number", "minimum": 0, "maximum": 300000},
        "status_classes": {"$ref": "#/$defs/counts"},
        "failures": {"$ref": "#/$defs/counts"},
        "discarded": {"$ref": "#/$defs/counts"},
        "termination_reason": {"enum": ["complete", "url_budget", "byte_budget", "time_budget"]}
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    }
  }
}
