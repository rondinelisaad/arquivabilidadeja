{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquivabilidade.ja/schemas/probes/v1/http-metadata-1.2.schema.json",
  "title": "Bounded HTTP discovery observation payload 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status_code", "headers", "response_bytes_observed", "response_byte_limit",
    "response_truncated", "redirect_count", "final_transport_secure",
    "elapsed_milliseconds", "content_type", "format_family", "html", "robots",
    "sitemap"
  ],
  "properties": {
    "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
    "headers": {"type": "object"},
    "response_bytes_observed": {"type": "integer", "minimum": 0, "maximum": 10485760},
    "response_byte_limit": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "response_truncated": {"type": "boolean"},
    "redirect_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "final_transport_secure": {"type": "boolean"},
    "elapsed_milliseconds": {"type": "number", "minimum": 0, "maximum": 120000},
    "content_type": {"type": ["string", "null"], "maxLength": 255},
    "format_family": {
      "enum": ["html", "xml", "css", "javascript", "image", "pdf", "audio", "video", "font", "other", "unknown"]
    },
    "html": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parseable", "link_count", "internal_link_count", "external_link_count", "feed_link_count", "canonical_present", "truncated"],
      "properties": {
        "parseable": {"type": ["boolean", "null"]},
        "link_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "internal_link_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "external_link_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "feed_link_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "canonical_present": {"type": "boolean"},
        "truncated": {"type": "boolean"}
      }
    },
    "robots": {"$ref": "#/$defs/auxiliary"},
    "sitemap": {"$ref": "#/$defs/auxiliary"}
  },
  "$defs": {
    "auxiliary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "status_code", "parseable", "item_count", "truncated", "elapsed_milliseconds"],
      "properties": {
        "outcome": {"enum": ["available", "http_error", "unavailable"]},
        "status_code": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "parseable": {"type": ["boolean", "null"]},
        "item_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "truncated": {"type": "boolean"},
        "elapsed_milliseconds": {"type": ["number", "null"], "minimum": 0, "maximum": 120000}
      }
    }
  }
}
