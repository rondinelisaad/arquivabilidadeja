{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquivabilidade.ja/schemas/evidence/v1/http-response-completeness.schema.json",
  "title": "R06 HTTP response completeness evidence data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bytes_observed",
    "content_length",
    "content_length_status",
    "content_length_matches_observed",
    "termination_reason",
    "limits"
  ],
  "properties": {
    "bytes_observed": {"type": "integer", "minimum": 0, "maximum": 10485760},
    "content_length": {"type": ["integer", "null"], "minimum": 0},
    "content_length_status": {
      "enum": ["absent", "valid", "invalid", "conflicting"]
    },
    "content_length_matches_observed": {"type": ["boolean", "null"]},
    "termination_reason": {
      "enum": ["complete", "response_byte_limit", "invalid_content_length", "content_length_mismatch"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_byte_limit"],
      "properties": {
        "response_byte_limit": {"type": "integer", "minimum": 1, "maximum": 10485760}
      }
    }
  }
}
