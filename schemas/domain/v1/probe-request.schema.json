{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquivabilidade.org/schemas/domain/v1/probe-request.schema.json",
  "title": "ProbeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id", "attempt_id", "subject_uri", "requested_at",
    "timeout_seconds", "max_response_bytes", "max_redirects"
  ],
  "properties": {
    "analysis_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "subject_uri": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048},
    "requested_at": {"type": "string", "format": "date-time"},
    "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 30},
    "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "max_redirects": {"type": "integer", "minimum": 0, "maximum": 5}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
