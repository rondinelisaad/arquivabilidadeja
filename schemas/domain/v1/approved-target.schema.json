{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquivabilidade.org/schemas/domain/v1/approved-target.schema.json",
  "title": "ApprovedTarget",
  "type": "object",
  "additionalProperties": false,
  "required": ["normalized_uri", "scheme", "hostname", "port", "addresses"],
  "properties": {
    "normalized_uri": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048},
    "scheme": {"enum": ["http", "https"]},
    "hostname": {"type": "string", "minLength": 1, "maxLength": 253},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "addresses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"type": "string", "format": "ipv4"},
          {"type": "string", "format": "ipv6"}
        ]
      }
    }
  }
}
