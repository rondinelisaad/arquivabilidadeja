{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquivabilidade.org/schemas/domain/v1/analysis.schema.json",
  "title": "Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id", "subject_uri", "methodology_id", "methodology_version",
    "state", "max_attempts", "attempt_ids", "created_at", "updated_at",
    "started_at", "finished_at", "revision"
  ],
  "properties": {
    "analysis_id": {"$ref": "#/$defs/identifier"},
    "subject_uri": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048},
    "methodology_id": {"$ref": "#/$defs/identifier"},
    "methodology_version": {"$ref": "#/$defs/identifier"},
    "state": {"enum": ["requested", "running", "completed", "partially_completed", "failed", "cancelled"]},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "attempt_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "revision": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
