{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquivabilidade.org/schemas/domain/v1/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id", "analysis_id", "indicator_id", "kind", "subject_uri",
    "method_id", "method_version", "created_at", "confidence", "sources",
    "data", "summary", "content_hash"
  ],
  "properties": {
    "evidence_id": {"$ref": "#/$defs/identifier"},
    "analysis_id": {"$ref": "#/$defs/identifier"},
    "indicator_id": {"$ref": "#/$defs/identifier"},
    "kind": {"$ref": "#/$defs/identifier"},
    "subject_uri": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048},
    "method_id": {"$ref": "#/$defs/identifier"},
    "method_version": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "content_hash", "probe_id", "tool_name", "tool_version", "observed_at"],
        "properties": {
          "observation_id": {"$ref": "#/$defs/identifier"},
          "content_hash": {"$ref": "#/$defs/sha256"},
          "probe_id": {"$ref": "#/$defs/identifier"},
          "tool_name": {"$ref": "#/$defs/identifier"},
          "tool_version": {"$ref": "#/$defs/identifier"},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "data": {"type": "object"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
